@model IEnumerable<ProjectApp.Models.Property>

@{
    ViewData["Title"] = "Property Listings by Region";
}

<div class="admin-page">
    <div class="admin-container">
        <h1 class="admin-title">Property Listings by Region</h1>
        <p class="admin-subtitle">Filter and view properties by location and price</p>

        <!-- Navigation Button -->
        <div class="admin-button-group align-right">
            <a href="@Url.Action("AdminDashboard", "Admin")" class="admin-btn admin-btn-secondary">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                    <path d="m8 2.748-.717-.737C5.6.281 2.514.878 1.4 3.053c-.523 1.023-.641 2.5.314 4.385.92 1.815 2.834 3.989 6.286 6.357 3.452-2.368 5.365-4.542 6.286-6.357.955-1.886.838-3.362.314-4.385C13.486.878 10.4.28 8.717 2.01zM8 15C-7.333 4.868 3.279-3.04 7.824 1.143c.06.055.119.112.176.171a3.12 3.12 0 0 1 .176-.17C12.72-3.042 23.333 4.867 8 15"/>
                </svg>
                Go to Dashboard
            </a>
        </div>

        <!-- Filter Form -->
        <div style="background: linear-gradient(135deg, rgba(255, 255, 255, 0.02), rgba(37, 99, 235, 0.05)); border: 2px solid rgba(255, 255, 255, 0.1); border-radius: var(--radius-xl); padding: var(--spacing-xl); margin-bottom: var(--spacing-2xl); backdrop-filter: blur(20px);">
            <h3 style="color: var(--text-light-primary); font-size: 1.5rem; font-weight: 700; margin-bottom: var(--spacing-lg); text-align: center;">Filter Properties</h3>
            
            @using (Html.BeginForm("ViewByRegion", "Admin", FormMethod.Get, new { @class = "row" }))
            {
                <!-- City Filter -->
                <div class="col-md-4 mb-3">
                    <label style="display: flex; align-items: center; gap: var(--spacing-sm); color: var(--text-light-secondary); font-weight: 600; margin-bottom: var(--spacing-sm);">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10zm0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6z"/>
                        </svg>
                        Select City:
                    </label>
                    @Html.DropDownList("cityName", (SelectList)ViewBag.cityList, "Choose City", new { @class = "form-control", style = "width: 100%; padding: 1rem; background: linear-gradient(135deg, rgba(255, 255, 255, 0.05), rgba(37, 99, 235, 0.05)); border: 2px solid rgba(255, 255, 255, 0.2); border-radius: var(--radius-lg); color: var(--text-light-primary); backdrop-filter: blur(10px);" })
                </div>

                <!-- Sort by Price -->
                <div class="col-md-4 mb-3">
                    <label style="display: flex; align-items: center; gap: var(--spacing-sm); color: var(--text-light-secondary); font-weight: 600; margin-bottom: var(--spacing-sm);">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M4 10.781c.148 1.667 1.513 2.85 3.591 3.003V15h1.043v-1.216c2.27-.179 3.678-1.438 3.678-3.3 0-1.59-.947-2.51-2.956-3.028l-.722-.187V3.467c1.122.11 1.879.714 2.07 1.616h1.47c-.166-1.6-1.54-2.748-3.54-2.875V1H7.591v1.233c-1.939.23-3.27 1.472-3.27 3.156 0 1.454.966 2.483 2.661 2.917l.61.162v4.031c-1.149-.17-1.94-.8-2.131-1.718H4zm3.391-3.836c-1.043-.263-1.6-.825-1.6-1.616 0-.944.704-1.641 1.8-1.828v3.495l-.2-.05zm1.591 1.872c1.287.323 1.852.859 1.852 1.769 0 1.097-.826 1.828-2.2 1.939V8.73l.348.086z"/>
                        </svg>
                        Sort by Price:
                    </label>
                    @Html.DropDownList("sortOrder", (SelectList)ViewBag.orderPrice, "Order by Price", new { @class = "form-control", style = "width: 100%; padding: 1rem; background: linear-gradient(135deg, rgba(255, 255, 255, 0.05), rgba(37, 99, 235, 0.05)); border: 2px solid rgba(255, 255, 255, 0.2); border-radius: var(--radius-lg); color: var(--text-light-primary); backdrop-filter: blur(10px);" })
                </div>

                <!-- Filter Button -->
                <div class="col-md-4 mb-3 d-flex align-items-end">
                    <button type="submit" class="admin-btn admin-btn-primary" style="width: 100%;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M6 10.5a.5.5 0 0 1 .5-.5h3a.5.5 0 0 1 0 1h-3a.5.5 0 0 1-.5-.5m-2-3a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7a.5.5 0 0 1-.5-.5m-2-3a.5.5 0 0 1 .5-.5h11a.5.5 0 0 1 0 1h-11a.5.5 0 0 1-.5-.5"/>
                        </svg>
                        Apply Filters
                    </button>
                </div>
            }
        </div>

        <!-- Properties Table -->
        <div class="admin-table-container">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Property Name</th>
                        <th>Property Type</th>
                        <th>Address</th>
                        <th>Price Range</th>
                        <th>Initial Deposit</th>
                        <th>Property Details</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var property in Model)
                    {
                        <tr>
                            <td>@property.PropertyName</td>
                            <td>@property.PropertyType</td>
                            <td>@property.Address</td>
                            <td>₹@property.PriceRange.ToString("N0")</td>
                            <td>₹@(property.InitialDeposit?.ToString("N0") ?? "0")</td>
                            <td>
                                <a href="@Url.Action("Details", "Admin", new { propertyId = property.PropertyId })" class="admin-btn admin-btn-primary">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                        <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8M1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z"/>
                                        <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5M4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0"/>
                                    </svg>
                                    View Details
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>