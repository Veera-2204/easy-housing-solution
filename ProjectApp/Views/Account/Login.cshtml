@model ProjectApp.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="auth-page">
    <div class="auth-container">
        <div class="auth-wrapper" id="auth-wrapper">
            <div class="auth-header">
                <h1 class="auth-title">Welcome Back</h1>
                <p class="auth-subtitle">Sign in to access your account</p>
            </div>

            <form asp-action="Login" method="post" class="auth-form">
                <div class="input-group">
                    <label asp-for="UserName" class="input-label">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M3 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1H3Zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"/>
                        </svg>
                        Username
                    </label>
                    <input asp-for="UserName" class="form-input" placeholder="Enter your username" autocomplete="username" />
                    <span asp-validation-for="UserName" class="input-error"></span>
                </div>

                <div class="input-group">
                    <label asp-for="Password" class="input-label">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2zm3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/>
                        </svg>
                        Password
                    </label>
                    <input asp-for="Password" type="password" class="form-input" placeholder="Enter your password" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="input-error"></span>
                </div>

                <!-- Simple Error Display -->
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="form-error" id="error-message">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
                        </svg>
                        <div>
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <p>@error.ErrorMessage</p>
                            }
                        </div>
                    </div>
                }

                <div class="form-actions">
                    <button type="submit" class="btn-primary auth-submit" id="submitBtn">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0zm4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4zm-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10c-2.29 0-3.516.68-4.168 1.332-.678.678-.83 1.418-.832 1.664h10z"/>
                        </svg>
                        <span class="btn-text">Sign In</span>
                    </button>
                </div>

                <div class="auth-footer">
                    <p class="auth-link-text">
                        Don't have an account? 
                        <a asp-action="Register" class="auth-link">Create one here</a>
                    </p>
                    <p class="auth-link-text">
                        <small>Need help? Contact support at <a href="mailto:support@easyhousing.com" class="auth-link">support@easyhousing.com</a></small>
                    </p>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Cursor-following blur effect
            const authWrapper = document.getElementById('auth-wrapper');
            
            if (authWrapper) {
                authWrapper.addEventListener('mousemove', function(e) {
                    const rect = this.getBoundingClientRect();
                    const x = e.clientX - rect.left;
                    const y = e.clientY - rect.top;
                    
                    this.style.setProperty('--mouse-x', x + 'px');
                    this.style.setProperty('--mouse-y', y + 'px');
                });
                
                authWrapper.addEventListener('mouseenter', function() {
                    this.style.setProperty('--show-blur', '1');
                });
                
                authWrapper.addEventListener('mouseleave', function() {
                    this.style.setProperty('--show-blur', '0');
                });
            }

            // Simple error hiding on input
            const errorMsg = document.getElementById('error-message');
            const inputs = document.querySelectorAll('.form-input');

            function hideError() {
                if (errorMsg) {
                    errorMsg.style.display = 'none';
                }
            }

            inputs.forEach(input => {
                input.addEventListener('input', hideError);
            });

            // Simple form submission handling
            const form = document.querySelector('.auth-form');
            const submitBtn = document.getElementById('submitBtn');
            const btnText = submitBtn.querySelector('.btn-text');
            
            if (form && submitBtn) {
                form.addEventListener('submit', function() {
                    submitBtn.disabled = true;
                    if (btnText) {
                        btnText.textContent = 'Signing In...';
                    }
                });
            }
        });
    </script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}