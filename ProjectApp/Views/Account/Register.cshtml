@model ProjectApp.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<div class="auth-page">
    <div class="auth-container">
        <div class="auth-wrapper">
            <div class="auth-header">
                <h1 class="auth-title">Create Account</h1>
                <p class="auth-subtitle">Join us to start your property journey</p>
            </div>

            <form asp-action="Register" method="post" class="auth-form">
                <div class="input-group">
                    <label asp-for="UserName" class="input-label">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M3 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1H3Zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"/>
                        </svg>
                        Username
                    </label>
                    <input asp-for="UserName" class="form-input" placeholder="Choose a username" autocomplete="username" />
                    <span asp-validation-for="UserName" class="input-error"></span>
                </div>

                <div class="input-group">
                    <label asp-for="Email" class="input-label">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V4Zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1H2Zm13 2.383-4.708 2.825L15 11.105V5.383Zm-.034 6.876-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.741ZM1 11.105l4.708-2.897L1 5.383v5.722Z"/>
                        </svg>
                        Email Address
                    </label>
                    <input asp-for="Email" type="email" class="form-input" placeholder="Enter your email address" autocomplete="email" />
                    <span asp-validation-for="Email" class="input-error"></span>
                </div>

                <div class="input-group">
                    <label asp-for="Password" class="input-label">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2zm3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/>
                        </svg>
                        Password
                    </label>
                    <input asp-for="Password" type="password" class="form-input" placeholder="Create a strong password" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="input-error"></span>
                </div>

                <div class="input-group">
                    <label asp-for="UserType" class="input-label">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M2 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2zm4.5 0a.5.5 0 0 0-.5.5v1a.5.5 0 0 0 .5.5h3a.5.5 0 0 0 .5-.5v-1a.5.5 0 0 0-.5-.5h-3zM8 5a1 1 0 1 0 0 2 1 1 0 0 0 0-2zM4.5 8a.5.5 0 0 0 0 1h7a.5.5 0 0 0 0-1h-7zm0 2.5a.5.5 0 0 0 0 1h7a.5.5 0 0 0 0-1h-7z"/>
                        </svg>
                        Account Type
                    </label>
                    <select asp-for="UserType" class="form-select">
                        <option value="">Select account type</option>
                        <option value="Buyer">Buyer - I want to buy/rent properties</option>
                        <option value="Seller">Seller - I want to sell/rent my properties</option>
                    </select>
                    <span asp-validation-for="UserType" class="input-error"></span>
                </div>

                <!-- Simple Error Display -->
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="form-error" id="error-message">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
                        </svg>
                        <div>
                            <strong>Please fix the following errors:</strong>
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <p>@error.ErrorMessage</p>
                            }
                        </div>
                    </div>
                }

                <div class="form-actions">
                    <button type="submit" class="btn-primary auth-submit" id="submitBtn">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                            <path d="m10.97 4.97-.02.022-3.473 4.425-2.093-2.094a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-1.071-1.05z"/>
                        </svg>
                        <span class="btn-text">Create Account</span>
                    </button>
                </div>

                <div class="auth-footer">
                    <p class="auth-link-text">
                        Already have an account? 
                        <a asp-action="Login" class="auth-link">Sign in here</a>
                    </p>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Simple error hiding on input
            const errorMsg = document.getElementById('error-message');
            const inputs = document.querySelectorAll('.form-input, .form-select');

            function hideError() {
                if (errorMsg) {
                    errorMsg.style.display = 'none';
                }
            }

            inputs.forEach(input => {
                input.addEventListener('input', hideError);
                input.addEventListener('change', hideError);
            });

            // Simple form submission handling
            const form = document.querySelector('.auth-form');
            const submitBtn = document.getElementById('submitBtn');
            const btnText = submitBtn.querySelector('.btn-text');
            
            if (form && submitBtn) {
                form.addEventListener('submit', function() {
                    submitBtn.disabled = true;
                    if (btnText) {
                        btnText.textContent = 'Creating Account...';
                    }
                });
            }
        });
    </script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}