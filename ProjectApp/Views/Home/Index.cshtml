@model IEnumerable<ProjectApp.Models.Property>

@{
    ViewData["Title"] = "Easy Housing Solutions";
}

<!-- Hero Section with Search -->
<section class="hero-modern home-hero">
    <div class="hero-content">
        <div class="hero-text-content">
            <h1 class="hero-title">Find Your Perfect Home</h1>
            <p class="hero-subtitle">Discover thousands of properties for sale and rent with our modern, intuitive platform</p>
        </div>
        <div class="hero-actions">
            <a asp-controller="BuyerProperty" asp-action="Index" class="hero-cta-button">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.1zM12 6.5a5.5 5.5 0 1 1-11 0 5.5 5.5 0 0 1 11 0z" />
                </svg>
                Browse All Properties
            </a>
        </div>
    </div>
</section>
