@{
    ViewData["Title"] = "Contact Us";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <style>
        /* General Styles */
        body {
            font-family: Arial, sans-serif;
            background: linear-gradient(to top, #09203f 0%, #537895 100%);
            color: #f8f9fa;
            margin: 0;
            padding: 0;
        }

        .container {
            width: 90%;
            max-width: 900px;
            margin: 0 auto;
            padding: 20px;
        }

        .text-center {
            text-align: center;
        }

        .display-4 {
            font-size: 2.5rem;
            font-weight: 700;
            color: #ffffff;
            margin-bottom: 20px;
        }

        .lead {
            font-size: 1.25rem;
            font-weight: 300;
            color: #dcdcdc;
            margin-bottom: 20px;
        }

        p {
            font-size: 1rem;
            line-height: 1.6;
            color: #e0e0e0;
            margin-bottom: 20px;
        }

        ul {
            list-style-type: none;
            padding: 0;
        }

        li {
            font-size: 1rem;
            line-height: 1.6;
            color: #e0e0e0;
            margin-bottom: 10px;
        }

        .contact-section {
            background-color: #1a2b3d;
            border-radius: 8px;
            padding: 20px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
        }

        .contact-details {
            color: #e0e0e0;
        }

        .contact-details strong {
            color: #ffffff;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="text-center">
            <h1 class="display-4">Contact Us</h1>
            <p class="lead">We would love to hear from you!</p>
            <p>If you have any questions or need support, please contact us at:</p>
            <div class="contact-section">
                <ul class="contact-details">
                    <li><strong>Email:</strong> support@easyhousingsolutions.com</li>
                    <li><strong>Phone:</strong> (123) 456-7890</li>
                </ul>
            </div>
        </div>
    </div>
</body>
</html>
